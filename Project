#include <iostream>
#include <vector>
#include <string>
#include <map>
#include <stdexcept>
#include <memory>
#include <algorithm>
using namespace std;


// تعریف نوع داده برای ستون ها
enum class DataType { INT, STRING, FLOAT };

// یک ساختار برای تعریف یک ستون تعریف میکنیم
struct Column {
    string name;
    DataType type;

    Column(const string& n, DataType t) : name(n), type(t) {}
};

// برای ساختارمند کردن کدمون یه کلاس رکورد تعریف میکنیم
class Record {
private:
    vector<string> values_;
    int id_;

public:
    Record(int id, const vector<string>& values) : id_(id), values_(values) {}

    int getId() const { return id_; }
    const vector<string>& getValues() const { return values_; }

    void setValue(int index, const string& value) {
        if (index >= 0 && index < values_.size()) {
            values_[index] = value;
        }
    }
string getValue(int index) const {
        if (index >= 0 && index < values_.size()) {
            return values_[index];
        }
        return "";
    }
};
    


// طبق تعیین وظایف برای ایجاد یک جدول لازم داریم کلاس زیر را تعریف کنم
class TableSchema {
public:
    TableSchema(const string& tableName, const vector<Column>& columns) 
        : tableName_(tableName), columns_(columns) {}

    const string& getTableName() const { return tableName_; }
    const vector<Column>& getColumns() const { return columns_; }

    int getColumnIndex(const string& columnName) const {
        for (int i = 0; i < columns_.size(); ++i) {
            if (columns_[i].name == columnName) {
                return i;
            }
        }
        return -1;
    }

    bool validateRecord(const vector<string>& values) const {
        if (values.size() != columns_.size()) {
            return false;
        }

        
return true;
    }

private:
    string tableName_;
    vector<Column> columns_;
};


//یک کلاس برای مدیریت جدول داده ها تعریف میکنم 

class Database {
private:
    map<string, TableSchema> tables_;
    map<string, vector<unique_ptr<Record>>> data_;
    map<string, int> nextIds_;
public:


    // برای اضافه کردن یک جدول جدید
    void addTable(const TableSchema& schema) {
        string tableName = schema.getTableName();
        tables_.emplace(tableName, schema);
        data_[tableName] = vector<unique_ptr<Record>>();
        nextIds_[tableName] = 1;
    }


       // نمایش تمام جدول های موجودمون
    void showTables() const {
        cout << "Tables in Arvan Database:\n";
        for (const auto& pair : tables_) {
            cout << "- " << pair.first << " (";
            const auto& columns = pair.second.getColumns();
            for (size_t i = 0; i < columns.size(); ++i) {
                cout << columns[i].name;
                if (i < columns.size() - 1) cout << ", ";
            }
            cout << ")\n";
        }
    }


    // نشون دادن یک جدول
    void showTableData(const string& tableName) const {
        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }

        const auto& schema = tableIt->second;
        const auto& records = data_.at(tableName);
    //نمایش هدر 
cout << "Table: " << tableName << "\nID\t";
        for (const auto& col : schema.getColumns()) {
            cout << col.name << "\t";
        }
        cout << "\n";

    // نمایش داده‌ها
        for (const auto& record : records) {
            cout << record->getId() << "\t";
        for (const auto& value : record->getValues()) {
                cout << value << "\t";
            }
            cout << "\n";
        }
    }

    // درج کردن رکورد جدید
    bool insertRecord(const string& tableName, const vector<string>& values) {
        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }
        const auto& schema = tableIt->second;
        if (!schema.validateRecord(values)) {
            throw runtime_error("Invalid record data");
        }
    int newId = nextIds_[tableName]++;
        data_[tableName].emplace_back(make_unique<Record>(newId, values));
        return true;
    }







        // جستجوی کردن تو جدول :رکوردها
    vector<const Record*> findRecords(const string& tableName, const string& columnName, const string& value) const {
        vector<const Record*> results;

        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }

        const auto& schema = tableIt->second;
        int colIndex = schema.getColumnIndex(columnName);
        if (colIndex == -1) {
            throw runtime_error("Column not found");
        }
const auto& records = data_.at(tableName);
        for (const auto& record : records) {
            if (record->getValue(colIndex) == value) {
                results.push_back(record.get());
            }
        }

        return results;
    }





        // به‌روزرسانی رکورد
    int updateRecords(const string& tableName, const string& columnName, const string& oldValue, const string& newValue) {
        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }

        const auto& schema = tableIt->second;
        int colIndex = schema.getColumnIndex(columnName);
        if (colIndex == -1) {
            throw runtime_error("Column not found");
        }

      int updatedCount = 0;
        auto& records = data_[tableName];
        for (auto& record : records) {
            if (record->getValue(colIndex) == oldValue) {
                record->setValue(colIndex, newValue);
                updatedCount++;
            }
        }

        return updatedCount;
    }




        // حذف رکورد
    bool deleteRecord(const string& tableName, int recordId) {
        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }

        auto& records = data_[tableName];
        auto it = find_if(records.begin(), records.end(), 
            [recordId](const unique_ptr<Record>& r) { return r->getId() == recordId; });

        if (it != records.end()) {
            records.erase(it);
            return true;
        }

        return false;
    }
};



// تابع برای تست سیستممون
void testArvanDatabase() {
    Database arvanDB;

    // ایجاد جدول ها
    vector<Column> personColumns = {
        Column("name", DataType::STRING),
        Column("age", DataType::INT),
        Column("occupation", DataType::STRING)
    };
    arvanDB.addTable(TableSchema("Person", personColumns));

    vector<Column> locationColumns = {
        Column("name", DataType::STRING),
        Column("region", DataType::STRING),
        Column("population", DataType::INT)
    };
    arvanDB.addTable(TableSchema("Location", locationColumns));

    // نمایش جدولا
    arvanDB.showTables();
    // درج داده‌ها
    arvanDB.insertRecord("Person", {"Sina", "19", "Driver"});
    arvanDB.insertRecord("Person", {"Helia", "18", "Programer"});
    arvanDB.insertRecord("Person", {"Elara", "28", "Healer"});

    arvanDB.insertRecord("Location", {"Velenjak", "Northern", "5000"});
    arvanDB.insertRecord("Location", {"Jahrom", "Eastern", "3200"});
    arvanDB.insertRecord("Location", {"Eze", "Northern", "4500"});
    // نمایش داده‌ها
    cout << "\nBefore updates:\n";
    arvanDB.showTableData("Person");
    arvanDB.showTableData("Location");

    // جستجو و به‌روزرسانی
    auto warriors = arvanDB.findRecords("Person", "occupation", "Warrior");
    cout << "\nFound " << warriors.size() << " warriors:\n";
    for (auto r : warriors) {
        cout << "ID: " << r->getId() << ", Name: " << r->getValue(0) << "\n";
    }

    int updated = arvanDB.updateRecords("Person", "occupation", "Warrior", "Knight");
    cout << "\nUpdated " << updated << " records\n";

    // حذف یه رکورد
    arvanDB.deleteRecord("Location", 1);

    // نمایش نهاییمون
    cout << "\nAfter updates:\n";
    arvanDB.showTableData("Person");
    arvanDB.showTableData("Location");
}

int main() {
    try {
        testArvanDatabase();
    } catch (const exception& e) {
        cerr << "Error: " << e.what() << endl;
        return 1;
    }
    return 0;
}



