        // جستجوی کردن تو جدول :رکوردها
    vector<const Record*> findRecords(const string& tableName, const string& columnName, const string& value) const {
        vector<const Record*> results;

        auto tableIt = tables_.find(tableName);
        if (tableIt == tables_.end()) {
            throw runtime_error("Table not found");
        }

        const auto& schema = tableIt->second;
        int colIndex = schema.getColumnIndex(columnName);
        if (colIndex == -1) {
            throw runtime_error("Column not found");
        }
const auto& records = data_.at(tableName);
        for (const auto& record : records) {
            if (record->getValue(colIndex) == value) {
                results.push_back(record.get());
            }
        }

        return results;
    }





