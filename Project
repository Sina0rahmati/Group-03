// تعریف نوع داده برای ستون ها
enum class DataType { INT, STRING, FLOAT };

// یک ساختار برای تعریف یک ستون تعریف میکنیم
struct Column {
    string name;
    DataType type;

    Column(const string& n, DataType t) : name(n), type(t) {}
};


// طبق تعیین وظایف برای ایجاد یک جدول لازم داریم کلاس زیر را تعریف کنم
class TableSchema {
public:
    TableSchema(const string& tableName, const vector<Column>& columns) 
        : tableName_(tableName), columns_(columns) {}

    const string& getTableName() const { return tableName_; }
    const vector<Column>& getColumns() const { return columns_; }

    int getColumnIndex(const string& columnName) const {
        for (int i = 0; i < columns_.size(); ++i) {
            if (columns_[i].name == columnName) {
                return i;
            }
        }
        return -1;
    }

    bool validateRecord(const vector<string>& values) const {
        if (values.size() != columns_.size()) {
            return false;
        }

        
return true;
    }

private:
    string tableName_;
    vector<Column> columns_;
};


