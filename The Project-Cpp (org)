using namespace std;  


struct Columns {
    string name;  
    string type; 
};

//تعریف بخش رکورد با مپ و رشته یا همون استرینگ خودمون
using Record = map<string, string>;

 //تعریف کلاس تیبل اسکما برای شکل دهی جدول اصلی که قراره ایجاد بشه
class TableSchema {
    string tableName_; 
    vector<Columns> columns_; 
    map<int, Record> records_; 
    int nextId_ = 1; 

public:
//یه جدول پیش‌فرض درست میکنیم
    TableSchema() = default; 

    TableSchema(const string& tableName, const vector<Columns>& columns)
        : tableName_(tableName), columns_(columns) {}

    // getName: برای اینه که اسم جدول رو باهاش تعیین کنیم
    
    const string& getName() const {
        return tableName_;
    }

    // getColumns: برای گرفتن لیست ستون های جدول مون 
    const vector<Columns>& getColumns() const {
        return columns_;
    }

    // addRecord: واسه ایجاد یه رکورد جدید به جدول مون 
    void addRecord(const Record& record) {
        records_[nextId_++] = record;
    }

    // deleteRecord: برای حذف کردن یه رکورد
    
    void deleteRecord(int id) {
        records_.erase(id);
    }

    // updateRecord: واسه بروزرسانی یه رکورد

    void updateRecord(int id, const Record& newRecord) {
        if (records_.count(id)) {
            records_[id] = newRecord;
        }
    }

    // printRecords: چاپ تمام رکوردهای جدول 
    
    void printRecords() const {
        cout << "Table: " << tableName_ << "\n";
        cout << left << setw(8) << "ID"; // واسه چاپ کردن عنوان با پهنای هشت و دیتیل ID
        for (const auto& col : columns_) {
            cout << setw(10) << col.name; // برای چاپ اسم هر ستون با اندازه ده تا 
            
        }
        cout << "\n";
        for (const auto& [id, record] : records_) { 
        // پیمایش تمام رکوردها
            cout << setw(8) << id; 
            for (const auto& col : columns_) {
                auto it = record.find(col.name);
                // برای سرچ کردن 
                cout << setw(10) << (it != record.end() ? it->second : ""); 
                // چاپ کردن مقدار ستون با پهنای 10 کاراکتر و اینکه تراز چپ داشته باشه، اگر مقدار وجود نداشت باشه، یک رشته خالی چاپ میشه
            }
            cout << "\n";
        }
    }



    // hasRecord: این بخش رو بابت بررسی وجودیت یک رکورد قرار میدیم
    bool hasRecord(int id) const {
        return records_.count(id);
    }

    void findRecord(const string& columnName, const string& value) const {
        cout << "Searching for " << columnName << " = " << value << "\n";
        bool found = false;
        cout << left << setw(8) << "ID";
        for (const auto& col : columns_) {
            cout << setw(10) << col.name;
        }
        cout << "\n";
        for (const auto& [id, record] : records_) {
            auto it = record.find(columnName);
            if (it != record.end() && it->second == value) {
                cout << setw(8) << id;
                for (const auto& col : columns_) {
                    auto valIt = record.find(col.name);
                    cout << setw(10) << (valIt != record.end() ? valIt->second : "");
                }
                cout << "\n";
                found = true;
            }
        }
        if (!found) {
            cout << "No matching records found.\n";
        }
    }
};




// کلاس DbInfo: نگهداری اطلاعات مربوط به پایگاه داده، مانند جدولا

class DbInfo {
public:
    map<string, TableSchema> tables_; // نگاشتی از نام جدول به TableSchema
};

// کلاس Database:مدیریت عملیات مربوط به  دیتابیس 

class Database {
    unique_ptr<DbInfo> dbInfo_; // اشاره‌گر یکتا به DbInfo برای مدیریت اطلاعات پایگاه داده

public:
    // سازنده: ایجاد یک Database با مقداردهی اولیه DbInfo
    Database() : dbInfo_(make_unique<DbInfo>()) {}

    // createTable: درست کردن یه جدول جدید
    void createTable(const string& tableName, const vector<Columns>& columns) {
        if (dbInfo_->tables_.count(tableName)) {
            cout << "Table already exists.\n";
            return;
        }
        dbInfo_->tables_.emplace(tableName, TableSchema(tableName, columns));
        cout << "Table '" << tableName << "' created.\n";
    }


        void deleteTable(const string& tableName) {
        if (!dbInfo_->tables_.erase(tableName)) {
            cout << "No such table.\n";
        } else {
            cout << "Table '" << tableName << "' deleted.\n";
        }
    }


     void listTables() const {
        if (dbInfo_->tables_.empty()) {
            cout << "No tables defined yet.\n";
            return;
        }
        cout << "Tables:\n";
        for (const auto& pair : dbInfo_->tables_) {
            cout << " - " << pair.first << "\n";
        }
    }


    // getColumns: گرفتن لیست ستونای یه جدول
    const vector<Columns>& getColumns(const string& tableName) const {
        return dbInfo_->tables_.at(tableName).getColumns();
    }

    bool hasTable(const string& name) const {
        return dbInfo_->tables_.count(name);
    }

    // getTable: دریافت کردن یه جدول
    TableSchema& getTable(const string& name) {
        return dbInfo_->tables_.at(name);
    }
};

