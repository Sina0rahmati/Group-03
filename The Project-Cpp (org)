#include <iostream> 
#include <map> 
#include <memory>   
#include <string> 
#include <vector> 
#include <sstream> 
#include <iomanip>
using namespace std;  


struct Columns {
    string name;  
    string type; 
};

//تعریف بخش رکورد با مپ و رشته یا همون استرینگ خودمون
using Record = map<string, string>;

 //تعریف کلاس تیبل اسکما برای شکل دهی جدول اصلی که قراره ایجاد بشه
class TableSchema {
    string tableName_; 
    vector<Columns> columns_; 
    map<int, Record> records_; 
    int nextId_ = 1; 

public:
//یه جدول پیش‌فرض درست میکنیم
    TableSchema() = default; 

    TableSchema(const string& tableName, const vector<Columns>& columns)
        : tableName_(tableName), columns_(columns) {}

    // getName: برای اینه که اسم جدول رو باهاش تعیین کنیم
    
    const string& getName() const {
        return tableName_;
    }

    // getColumns: برای گرفتن لیست ستون های جدول مون 
    const vector<Columns>& getColumns() const {
        return columns_;
    }

    // addRecord: واسه ایجاد یه رکورد جدید به جدول مون 
    void addRecord(const Record& record) {
        records_[nextId_++] = record;
    }

    // deleteRecord: برای حذف کردن یه رکورد
    
    void deleteRecord(int id) {
        records_.erase(id);
    }

    // updateRecord: واسه بروزرسانی یه رکورد

    void updateRecord(int id, const Record& newRecord) {
        if (records_.count(id)) {
            records_[id] = newRecord;
        }
    }

    // printRecords: چاپ تمام رکوردهای جدول 
    
    void printRecords() const {
        cout << "Table: " << tableName_ << "\n";
        cout << left << setw(8) << "ID"; // واسه چاپ کردن عنوان با پهنای هشت و دیتیل ID
        for (const auto& col : columns_) {
            cout << setw(10) << col.name; // برای چاپ اسم هر ستون با اندازه ده تا 
            
        }
        cout << "\n";
        for (const auto& [id, record] : records_) { 
        // پیمایش تمام رکوردها
            cout << setw(8) << id; 
            for (const auto& col : columns_) {
                auto it = record.find(col.name);
                // برای سرچ کردن 
                cout << setw(10) << (it != record.end() ? it->second : ""); 
                // چاپ کردن مقدار ستون با پهنای 10 کاراکتر و اینکه تراز چپ داشته باشه، اگر مقدار وجود نداشت باشه، یک رشته خالی چاپ میشه
            }
            cout << "\n";
        }
    }
